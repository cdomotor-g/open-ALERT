#!/bin/bash
# open-alert-base — the platform's own command on an open-ALERT base station.
#
#   open-alert-base version          what is installed: this package, the agent, the signed release it came from
#   open-alert-base status           is the service running, which profile, and the agent's own status
#   open-alert-base profile          which profile is in force, and the ones there are
#   open-alert-base profile <name>   put a profile in force: standard or enterprise          (root)
#   open-alert-base sync             make the service and the firewall lock follow the profile
#                                    and the settings as they are now (after changing the
#                                    port, say)                                               (root)
#   open-alert-base audit            the security posture, for a reviewer: what listens, who it
#                                    runs as, what it is kept from, what is switched off      (root, for all of it)
#   open-alert-base selftest         run the agent's own tests on this computer (a few minutes)
#   open-alert-base bench [options]  measure how many channels this computer will carry
#
# The agent's own command is "rpi-alert" (rpi-alert status, rpi-alert setup, …).
set -euo pipefail
# Files this command makes are readable by all and writable by root only,
# whatever the caller's own setting.
umask 022

LIB=/usr/lib/open-alert-base
SHARE=/usr/share/open-alert-base
AGENT=$LIB/agent
ETC=/etc/open-alert-base
UNIT=open-alert-base.service
UNIT_FILE=/usr/lib/systemd/system/$UNIT
FW_UNIT=open-alert-base-firewall.service
FW_RULES=$ETC/dashboard-local-only.nft
FW_TABLE=open_alert_base
DROPIN_DIR=/etc/systemd/system/$UNIT.d
DROPIN=$DROPIN_DIR/10-low-port.conf
LOCK_DROPIN=$DROPIN_DIR/20-dashboard-lock.conf
KEEPER=$LIB/lock-keeper
SVC_USER=rpi-alert
SETTINGS_DIR=/etc/rpi-alert
DATA_DIR=/var/lib/rpi-alert
NODE=/usr/bin/node

say()  { printf '%s\n' "$*"; }
warn() { printf 'open-alert-base: %s\n' "$*" >&2; }
die()  { printf 'open-alert-base: %s\n' "$*" >&2; exit 1; }
is_root() { [ "$(id -u)" = 0 ]; }
need_root() { is_root || die "this needs the administrator account: sudo open-alert-base $*"; }
have_systemd() { [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; }

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }

# Run something as the agent's own user: root never reads or writes in the
# agent's folders itself.
as_agent() {
  if is_root; then
    runuser -u "$SVC_USER" -- env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME="$DATA_DIR" "$@"
  elif [ "$(id -un)" = "$SVC_USER" ]; then
    "$@"
  else
    return 77
  fi
}

pin() { sed -n "s|^$1=\(.*\)\$|\1|p" "$SHARE/PIN" 2>/dev/null | tail -n 1; }
package_version() { cat "$SHARE/VERSION" 2>/dev/null || echo unknown; }
agent_version() { sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$AGENT/package.json" 2>/dev/null | head -n 1; }
current_profile() { if [ -r "$ETC/profile" ]; then head -n 1 "$ETC/profile"; else echo "none recorded"; fi; }
profile_file() { case "$1" in *[!a-z0-9-]*|'') return 1 ;; esac; [ -f "$SHARE/profiles/$1.json" ] && printf '%s' "$SHARE/profiles/$1.json"; }
profile_names() { local f; for f in "$SHARE"/profiles/*.json; do basename "$f" .json; done | tr '\n' ' ' | sed 's/ $//'; }
profile_about() { sed -n 's/^[[:space:]]*"about"[[:space:]]*:[[:space:]]*"\(.*\)",\{0,1\}[[:space:]]*$/\1/p' "$1" | head -n 1; }

# The settings that matter here, as NAME=value lines (settings.js summary).
SUMMARY=''
load_summary() {
  local rc=0
  SUMMARY=$(as_agent "$NODE" "$LIB/settings.js" summary 2>/dev/null) || rc=$?
  return "$rc"
}
setting() { printf '%s\n' "$SUMMARY" | sed -n "s|^$1=\(.*\)\$|\1|p" | head -n 1; }
is_loopback() { case "$1" in 127.*|::1|localhost) return 0 ;; *) return 1 ;; esac; }

# A settings file that root put in place (configuration management, a restored
# backup, cloud-init) belongs to root, and the agent cannot read it: it would
# run on its built-in settings, without the token. Such a file is handed to
# the agent's user. adopt-settings.js does it on the open file itself, never
# through its name, and only for a plain file that is root's: a link, or a
# file with a second name somewhere else, is left alone and said so.
adopt_settings() {
  local f="$SETTINGS_DIR/config.json"
  is_root || return 0
  id "$SVC_USER" >/dev/null 2>&1 || return 0
  if [ ! -e "$f" ] && [ ! -L "$f" ]; then return 0; fi
  "$NODE" "$LIB/adopt-settings.js" "$f" "$(id -u "$SVC_USER")" "$(id -g "$SVC_USER")" || true
}

# What the profile in force asks of the dashboard. The profile is root's own
# record (/etc/open-alert-base/profile names it; its file under
# /usr/share/open-alert-base/profiles is root's too). Left in P_NAME, P_PORT
# and P_BIND; all three empty when no profile is recorded.
P_NAME=''; P_PORT=''; P_BIND=''
load_profile() {
  local name file web
  P_NAME=''; P_PORT=''; P_BIND=''
  [ -r "$ETC/profile" ] || return 0
  name=$(head -n 1 "$ETC/profile")
  file=$(profile_file "$name") || return 0
  web=$("$NODE" -e '
    const p = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"));
    const w = (p.settings || {}).web || {};
    process.stdout.write(String(w.port == null ? "" : w.port) + " " + String(w.bind == null ? "" : w.bind));' "$file" 2>/dev/null) || return 0
  P_NAME=$name; P_PORT=${web%% *}; P_BIND=${web#* }
}
# Does the profile in force keep the dashboard to this computer?
profile_locks() { [ -n "$P_NAME" ] && is_loopback "$P_BIND"; }

# The settings the profile in force holds (settings.js held), and those the
# settings file now has looser than the profile holds them (settings.js
# looser: a line each). The start command puts the looser ones back each time
# the agent starts; until then the running agent may be using them.
P_HELD=''; LOOSER=''
load_held() {
  local file
  P_HELD=''; LOOSER=''
  [ -n "$P_NAME" ] || return 0
  file=$(profile_file "$P_NAME") || return 0
  P_HELD=$(as_agent "$NODE" "$LIB/settings.js" held "$file" 2>/dev/null) || P_HELD=''
  LOOSER=$(as_agent "$NODE" "$LIB/settings.js" looser "$file" 2>/dev/null) || LOOSER=''
}
# The looser ones other than web.bind (which has words of its own, beside the firewall lock).
looser_others() { printf '%s\n' "$LOOSER" | grep -v -e '^web\.bind ' -e '^$' || true; }

# The port the agent really opens. One below 1024 needs the privilege that only
# the drop-in file ($DROPIN) gives the service (unless this computer lets every
# user open it: net.ipv4.ip_unprivileged_port_start); without it the agent is
# refused that port and falls back to 8080.
served_port() {
  local low
  low=$(cat /proc/sys/net/ipv4/ip_unprivileged_port_start 2>/dev/null || true)
  case "$low" in ''|*[!0-9]*) low=1024 ;; esac
  if [ "$1" -lt 1024 ] 2>/dev/null && [ "$1" -lt "$low" ] && [ ! -e "$DROPIN" ]; then echo 8080; else echo "$1"; fi
}

# The dashboard's settings in words.
login_words() {
  case "$1" in
    all) echo "nothing is shown to another computer, or through a reverse proxy, without the dashboard's password" ;;
    settings) echo "looking needs no password; changing anything needs the dashboard's password" ;;
    *) echo "${1:-not set}" ;;
  esac
}
itself_words() {
  case "$1" in
    true) echo "a request on this computer's own address (127.0.0.1) is this computer itself only when it asks for 127.0.0.1 or localhost by name, with none of a reverse proxy's headers. A reverse proxy's caller is a visitor, and so is a web page in a browser here that comes from another site or from a name pointed at this computer; any program on this computer, and a page that this computer itself serves (localhost or 127.0.0.1, on any port), still count as this computer itself" ;;
    false) echo "every request on this computer's own address (127.0.0.1) without X-Forwarded-For is taken for this computer itself — a web page in a browser here, too, from any site" ;;
    *) echo "${1:-not set}" ;;
  esac
}

# The running agent's process number, or nothing: asked of systemd, else found
# among the agent user's own processes.
agent_pid() {
  local pid='' d uid
  if have_systemd; then pid=$(systemctl show -p MainPID --value "$UNIT" 2>/dev/null || true); fi
  case "$pid" in ''|0|*[!0-9]*) pid='' ;; esac
  if [ -z "$pid" ] && id "$SVC_USER" >/dev/null 2>&1; then
    uid=$(id -u "$SVC_USER")
    for d in /proc/[0-9]*; do
      [ "$(stat -c %u "$d" 2>/dev/null || true)" = "$uid" ] || continue
      if tr '\0' ' ' < "$d/cmdline" 2>/dev/null | grep -qF "$AGENT/bin/rpi-alert daemon"; then pid=${d#/proc/}; break; fi
    done
  fi
  printf '%s' "$pid"
}
# A line of /proc/<pid>/status: its value.
proc_status() { sed -n "s/^$2:[[:space:]]*//p" "/proc/$1/status" 2>/dev/null | head -n 1; }
# A set of privileges as the kernel prints it (sixteen hex digits), in words.
caps_in_words() {
  case "$1" in
    0000000000000000) echo "none" ;;
    0000000000000400) echo "one: CAP_NET_BIND_SERVICE (open a port below 1024)" ;;
    '') echo "unknown" ;;
    *) echo "MORE THAN EXPECTED: $1" ;;
  esac
}

# Does this system's RTL-SDR library know the RTL-SDR Blog V4 stick? (The test
# RPi ALERT's own installer makes: the stick's name is in the library file.)
rtl_knows_v4() {
  local lib
  for lib in $( (ldconfig -p 2>/dev/null || /sbin/ldconfig -p 2>/dev/null || true) | awk '/librtlsdr\.so/ {print $NF}'); do
    if grep -aq "Blog V4" "$lib" 2>/dev/null; then return 0; fi
  done
  return 1
}
rtl_line() {
  local v
  v=$(dpkg-query -W -f '${Version}' rtl-sdr 2>/dev/null || true)
  if rtl_knows_v4; then
    printf 'rtl-sdr %s — knows the RTL-SDR Blog V4 stick as well as the V3 and generic ones' "${v:-(version unknown)}"
  else
    printf 'rtl-sdr %s — does NOT know the RTL-SDR Blog V4 stick: V3 and generic sticks only (Debian 13 and Ubuntu 24.04 have a newer rtl-sdr that does)' "${v:-(version unknown)}"
  fi
}

# ── version ──────────────────────────────────────────────────────────────────
cmd_version() {
  say "open-alert-base $(package_version)"
  say "RPi ALERT agent $(agent_version), unchanged from the signed release $(pin AGENT_TAG)"
  say "    release tarball  sha256 $(pin AGENT_SHA256)"
  say "    release key      $(pin KEY_FINGERPRINT)"
  say "Node.js $("$NODE" --version 2>/dev/null || echo 'not found') ($NODE)"
  say "$(rtl_line)"
}

# ── status ───────────────────────────────────────────────────────────────────
cmd_status() {
  say "open-alert-base $(package_version) — RPi ALERT agent $(agent_version)"
  if have_systemd; then
    say "Service    $(systemctl is-active "$UNIT" 2>/dev/null || true), $(systemctl is-enabled "$UNIT" 2>/dev/null || true) at start-up"
  else
    say "Service    systemd is not running here (a container, or a system being built): nothing to ask"
  fi
  say "Profile    $(current_profile)"
  local bad=0
  if is_root && load_summary; then
    local port bind served
    port=$(setting web.port); bind=$(setting web.bind); served=$(served_port "$port")
    load_profile
    if [ -n "$(setting unusable)" ]; then
      say "Settings   CANNOT BE USED — $(setting unusable)"
      if [ -n "$P_NAME" ] && printf '%s' "$(setting unusable)" | grep -q 'not valid JSON'; then
        say "           (when the agent next starts, it starts on the settings of the profile \"$P_NAME\", and the file is kept as config.json.bad)"
      else
        say "           (the agent runs on its built-in settings until this is put right — the dashboard's own at their most closed; then: sudo open-alert-base sync)"
      fi
      bad=1
    else
      if is_loopback "$bind" || profile_locks; then
        say "Dashboard  http://127.0.0.1:$served/ — for this computer only (firewall lock: $(lock_state))"
        if ! is_loopback "$bind"; then
          say "           THE SETTINGS NO LONGER MATCH THE PROFILE: they do not ask for \"this computer only\" any more. The lock is kept, and web.bind is put back when the agent next starts. See: sudo open-alert-base audit"
          bad=1
        fi
      elif [ -n "$bind" ]; then
        say "Dashboard  port $served, on $bind and on this computer itself"
      else
        say "Dashboard  port $served, for the local network"
      fi
      if [ "$served" != "$port" ]; then
        if [ -n "$P_NAME" ]; then
          say "           THE SETTINGS NO LONGER MATCH THE PROFILE: they ask for port $port, below 1024, and \"$P_NAME\" gives the service no privilege for a low port, so the agent falls back to $served. See: sudo open-alert-base audit"
        else
          say "           the settings ask for port $port, below 1024, and the service has no privilege for it, so the agent falls back to $served. To give it: sudo open-alert-base sync"
        fi
        bad=1
      fi
      say "Login      $(login_words "$(setting web.requireLogin)") (web.requireLogin $(setting web.requireLogin))"
      say "Own calls  $(if [ "$(setting web.behindProxy)" = true ]; then echo "only a request on 127.0.0.1 that asks for 127.0.0.1 or localhost by name, with none of a proxy's headers and from no other site's page, counts as this computer's own (web.behindProxy on)"; else echo "every request on 127.0.0.1 counts as this computer's own (web.behindProxy off)"; fi)"
      load_held
      local l
      while IFS= read -r l; do
        [ -n "$l" ] || continue
        say "           THE SETTINGS NO LONGER MATCH THE PROFILE: $l — put back when the agent next starts (sudo systemctl restart open-alert-base)"
        bad=1
      done < <(looser_others)
    fi
  fi
  say ""
  if ! /usr/bin/rpi-alert status 2>/dev/null; then
    say "The agent is not answering on this computer (try: sudo systemctl status open-alert-base)."
  fi
  return "$bad"
}

# ── the platform follows the settings ────────────────────────────────────────
# Both services start with the computer the usual way (multi-user.target).
# Where there is no systemctl to ask (a container, a system being built), the
# link that "enable" makes is made, or removed, by hand.
WANTS_DIR=/etc/systemd/system/multi-user.target.wants
unit_enable() {
  if command -v systemctl >/dev/null 2>&1 && systemctl enable "$1" >/dev/null 2>&1; then return 0; fi
  install -d -m 0755 "$WANTS_DIR" && ln -sf "/usr/lib/systemd/system/$1" "$WANTS_DIR/$1"
}
unit_disable() {
  if command -v systemctl >/dev/null 2>&1; then systemctl disable "$1" >/dev/null 2>&1 || true; fi
  rm -f "$WANTS_DIR/$1"
}
lock_state() {
  if ! command -v nft >/dev/null 2>&1; then echo "NOT ON — nftables is not installed"; return; fi
  if ! is_root; then echo "ask as root"; return; fi
  if nft list table inet "$FW_TABLE" >/dev/null 2>&1; then echo "on"; else echo "NOT ON"; fi
}
# Write a small file of the service's own (a "drop-in"), only when it differs.
# Sets UNITS_CHANGED=1 when systemd has to read its files again.
UNITS_CHANGED=0
write_dropin() {     # write_dropin FILE TEXT
  if [ ! -f "$1" ] || [ "$(cat "$1")" != "$2" ]; then
    install -d -m 0755 "$DROPIN_DIR"
    printf '%s\n' "$2" > "$1.new"; chmod 0644 "$1.new"; mv -f "$1.new" "$1"
    UNITS_CHANGED=1
    return 0
  fi
  return 1
}
remove_dropin() {    # remove_dropin FILE
  [ -f "$1" ] || return 1
  rm -f "$1"; rmdir "$DROPIN_DIR" 2>/dev/null || true
  UNITS_CHANGED=1
}

# Who decides what. The settings file belongs to the agent's own user, so
# nothing in it may loosen what root set up: the profile root put in force
# decides whether the dashboard is kept to this computer, and whether the
# service may have the privilege for a port below 1024. The settings can only
# ask for less: they can ask for the lock where the profile does not, and for
# a port that needs no privilege. Only "open-alert-base profile <name>", run
# by root, changes the profile.
#
# Sets CHANGED=1 when the service has to be restarted for it. Returns 3 when
# the dashboard should be for this computer only and the lock could not be put
# on; 4 when the settings no longer match the profile in force (the stricter
# of the two is kept).
CHANGED=0
sync_platform() {
  local port bind rc=0 want want_lock=0 may_low=1 l served
  adopt_settings
  load_summary || die "cannot read the agent's settings (is the package fully installed?)"
  if [ -n "$(setting unusable)" ]; then
    die "the agent's settings file ($(setting file)) cannot be used: $(setting unusable). Nothing was changed. Put the file right, or move it away, then run: sudo open-alert-base sync"
  fi
  port=$(setting web.port); bind=$(setting web.bind)
  case "$port" in ''|*[!0-9]*) die "the agent's settings give no usable dashboard port" ;; esac
  load_profile
  if profile_locks || is_loopback "$bind"; then want_lock=1; fi
  if [ -n "$P_NAME" ]; then
    case "$P_PORT" in ''|*[!0-9]*) may_low=0 ;; *) if [ "$P_PORT" -ge 1024 ]; then may_low=0; fi ;; esac
  else
    say "No profile is recorded on this computer, so the settings file alone decides. To put one in force: sudo open-alert-base profile standard   (or: enterprise)"
  fi

  if profile_locks && ! is_loopback "$bind"; then
    warn "THE SETTINGS NO LONGER MATCH THE PROFILE IN FORCE ($P_NAME)."
    warn "The profile keeps the dashboard to this computer. The settings file (which the agent's own user can write) no longer asks for that: web.bind is $(if [ -n "$bind" ]; then echo "\"$bind\""; else echo "empty (every address)"; fi)."
    warn "The firewall lock is KEPT ON, and web.bind is put back to $P_BIND each time the agent starts. If the settings were not changed on purpose, find out who changed them."
    warn "To open the dashboard to the local network on purpose: sudo open-alert-base profile standard"
    warn "To put the settings back as the profile has them:       sudo open-alert-base profile $P_NAME"
    rc=4; CHANGED=1
  fi
  # The other settings the profile holds (web.behindProxy, web.requireLogin):
  # no firewall stands behind them, so the agent is restarted, and the start
  # command puts them back as the profile has them before the agent starts.
  load_held
  local others
  others=$(looser_others)
  if [ -n "$others" ]; then
    warn "THE SETTINGS NO LONGER MATCH THE PROFILE IN FORCE ($P_NAME): the settings file, which the agent's own user can write, is looser than the profile holds:"
    while IFS= read -r l; do warn "    $l"; done <<< "$others"
    warn "They are put back as the profile has them each time the agent starts$(if have_systemd; then echo "; the service is restarted for it now, if it runs"; fi). If they were not changed on purpose, find out who changed them."
    rc=4; CHANGED=1
  fi

  # 1. A port below 1024 needs one privilege; any other port needs none. The
  #    privilege is given only where the profile in force itself uses such a port.
  if [ "$port" -lt 1024 ] && [ "$may_low" = 1 ]; then
    want="# Written by \"open-alert-base profile\" and \"open-alert-base sync\" — do not edit; it is rewritten.
# The dashboard's port ($port) is below 1024, which an ordinary user may not
# open. This gives the service that one privilege (CAP_NET_BIND_SERVICE) and
# no other.
[Service]
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE"
    if write_dropin "$DROPIN" "$want"; then
      CHANGED=1
      say "Port $port is below 1024: the service is given the one privilege to open it (and no other)."
    fi
  else
    if [ "$port" -lt 1024 ]; then
      warn "THE SETTINGS NO LONGER MATCH THE PROFILE IN FORCE ($P_NAME)."
      warn "The settings file puts the dashboard on port $port, below 1024. The profile's own port is ${P_PORT:-not given} and needs no privilege, so the service is given NONE: the agent cannot open port $port (it falls back to 8080)."
      warn "For a port below 1024: sudo open-alert-base profile standard. Otherwise choose a port from 1024 up."
      rc=4
    fi
    if remove_dropin "$DROPIN"; then
      CHANGED=1
      if [ "$port" -ge 1024 ]; then say "Port $port needs no privilege: the service runs with none at all."; fi
    fi
  fi

  # The port the agent will really open, now that the privilege is decided.
  served=$(served_port "$port")

  # 2. "For this computer only": the agent itself listens on this computer's
  #    own address only (web.bind, which the profile holds), and a firewall
  #    rule keeps other computers out as well — the second guard, should the
  #    agent ever listen on every address. The agent is tied to the rule: it
  #    runs only while the lock's service does.
  if [ "$want_lock" = 1 ]; then
    want="# Written by \"open-alert-base profile\" and \"open-alert-base sync\" — do not edit; it is rewritten.
# The dashboard is for this computer only, and the firewall lock is what keeps
# it so. The agent runs only while the lock's service does: no lock, no agent.
[Unit]
BindsTo=$FW_UNIT
After=$FW_UNIT"
    write_dropin "$LOCK_DROPIN" "$want" || true
    if [ "$UNITS_CHANGED" = 1 ] && have_systemd; then systemctl daemon-reload; UNITS_CHANGED=0; fi
    if ! grep -Eq "^define dashboard_port = $served\$" "$FW_RULES" 2>/dev/null; then
      warn "the dashboard is on port $served, and $FW_RULES names another: change its \"define dashboard_port\" line to $served, then run this again"
    fi
    unit_enable "$FW_UNIT" || warn "could not set the firewall lock to load at start-up"
    if ! command -v nft >/dev/null 2>&1; then
      warn "THE DASHBOARD'S LOCK CANNOT BE PUT ON: nftables is not installed."
      warn "The agent is not started without it (no lock, no agent). Install it (apt install nftables), then run: sudo open-alert-base sync"
      rc=3
    elif have_systemd; then
      # Running already: load the rules again in place (the agent is not disturbed). Otherwise start it.
      if { if systemctl is-active --quiet "$FW_UNIT"; then systemctl reload "$FW_UNIT"; else systemctl restart "$FW_UNIT"; fi; } \
         && nft list table inet "$FW_TABLE" >/dev/null 2>&1; then
        say "Firewall lock on: only this computer can reach the dashboard (port $served). The agent runs only while it holds."
      else
        warn "THE DASHBOARD'S LOCK COULD NOT BE PUT ON: the firewall rules do not load."
        warn "The agent is not started without it (no lock, no agent). See: systemctl status $FW_UNIT"
        warn "When it is put right: sudo open-alert-base sync"
        rc=3
      fi
    else
      say "Firewall lock: set to load when the computer starts, with the agent tied to it (systemd is not running here, so not loaded now)."
    fi
  else
    # Untie the agent first, so that taking the lock off does not stop it.
    remove_dropin "$LOCK_DROPIN" || true
    if [ "$UNITS_CHANGED" = 1 ] && have_systemd; then systemctl daemon-reload; UNITS_CHANGED=0; fi
    unit_disable "$FW_UNIT"
    if have_systemd && { systemctl is-active --quiet "$FW_UNIT" || systemctl is-failed --quiet "$FW_UNIT"; }; then
      systemctl stop "$FW_UNIT" || true; systemctl reset-failed "$FW_UNIT" 2>/dev/null || true
    fi
    if [ -x "$KEEPER" ]; then "$KEEPER" --remove || true; fi
  fi
  if [ "$UNITS_CHANGED" = 1 ] && have_systemd; then systemctl daemon-reload; UNITS_CHANGED=0; fi
  return "$rc"
}

cmd_sync() {
  need_root sync
  local rc=0
  sync_platform || rc=$?
  if [ "$rc" != 3 ] && [ "$CHANGED" = 1 ] && have_systemd && systemctl is-active --quiet "$UNIT"; then
    systemctl restart "$UNIT"; say "Service restarted."
  fi
  case "$rc" in
    0) say "The service and the firewall lock match the profile and the settings." ;;
    4) warn "sync: the stricter of the two is kept (see above); nothing was loosened" ;;
  esac
  return "$rc"
}

# ── profile ──────────────────────────────────────────────────────────────────
cmd_profile() {
  local name="${1:-}" file was_active=0 rc=0 n
  if [ -z "$name" ]; then
    say "Profile in force: $(current_profile)"
    say ""
    for n in $(profile_names); do
      say "  $n"
      profile_about "$SHARE/profiles/$n.json" | fold -s -w 76 | sed 's/^/      /'
    done
    say ""
    say "To put one in force: sudo open-alert-base profile <name>"
    if is_root && [ -r "$ETC/profile" ] && file=$(profile_file "$(current_profile)"); then
      local d; d=$(as_agent "$NODE" "$LIB/settings.js" differ "$file" 2>/dev/null || true)
      if [ -n "$d" ]; then say ""; say "Changed since \"$(current_profile)\" was put in force:"; printf '%s\n' "$d" | sed 's/^/  /'; fi
    fi
    return 0
  fi
  need_root "profile $name"
  file=$(profile_file "$name") || die "there is no profile called \"$name\". There are: $(profile_names)"
  id "$SVC_USER" >/dev/null 2>&1 || die "the user $SVC_USER does not exist (is the package fully installed?)"
  install -d -o "$SVC_USER" -g "$SVC_USER" -m 0750 "$SETTINGS_DIR" "$DATA_DIR"

  # The agent writes its settings file from memory when a setting changes, so
  # it is stopped while the file is changed underneath it.
  if have_systemd && systemctl is-active --quiet "$UNIT"; then was_active=1; systemctl stop "$UNIT"; fi
  adopt_settings
  if ! as_agent "$NODE" "$LIB/settings.js" apply "$file"; then
    if [ "$was_active" = 1 ]; then systemctl start "$UNIT" || true; fi
    die "the profile \"$name\" was not put in force"
  fi
  install -d -m 0755 "$ETC"
  printf '%s\n' "$name" > "$ETC/profile.new"; chmod 0644 "$ETC/profile.new"; mv -f "$ETC/profile.new" "$ETC/profile"
  sync_platform || rc=$?
  if [ "$was_active" = 1 ]; then
    if [ "$rc" = 3 ]; then warn "the service is NOT started again: in this profile the agent runs only behind the firewall lock"
    else systemctl start "$UNIT"; say "Service restarted."; fi
  fi
  case "$rc" in
    0) say "Profile \"$name\" is in force." ;;
    3) warn "profile \"$name\": the settings are in force, the firewall lock is not (see above)" ;;
    *) warn "profile \"$name\": the settings are in force, with the warnings above" ;;
  esac
  return "$rc"
}

# ── audit ────────────────────────────────────────────────────────────────────
# "0100007F" as /proc/net/tcp has it → 127.0.0.1
ipv4_of() { printf '%d.%d.%d.%d' "0x${1:6:2}" "0x${1:4:2}" "0x${1:2:2}" "0x${1:0:2}"; }
listening() {
  local uid="$1" f addr port hex a found=0
  for f in /proc/net/tcp /proc/net/tcp6; do
    [ -r "$f" ] || continue
    while read -r _ local_addr _ state _ _ _ sock_uid _; do
      if [ "$state" != 0A ] || [ "$sock_uid" != "$uid" ]; then continue; fi
      hex=${local_addr%:*}; port=$((16#${local_addr##*:}))
      if [ ${#hex} = 8 ]; then
        a=$(ipv4_of "$hex")
        case "$a" in 0.0.0.0) addr="every address of this computer (0.0.0.0)" ;; 127.*) addr="this computer only ($a)" ;; *) addr="$a" ;; esac
      else
        case "$hex" in
          00000000000000000000000000000000) addr="every address of this computer (::, IPv4 and IPv6)" ;;
          00000000000000000000000001000000) addr="this computer only (::1)" ;;
          0000000000000000FFFF00000100007F) addr="this computer only (127.0.0.1)" ;;
          *) addr="IPv6 address $hex" ;;
        esac
      fi
      say "    TCP port $port on $addr"
      found=1
    done < <(tail -n +2 "$f")
  done
  [ "$found" = 1 ] || say "    none (the agent is not running, or has opened no port)"
}
# Do the listening sockets of a user reach beyond this computer?  yes | no | nothing-open
reach_of() {
  local uid="$1" f hex found=nothing-open
  for f in /proc/net/tcp /proc/net/tcp6; do
    [ -r "$f" ] || continue
    while read -r _ local_addr _ state _ _ _ sock_uid _; do
      if [ "$state" != 0A ] || [ "$sock_uid" != "$uid" ]; then continue; fi
      hex=${local_addr%:*}
      case "$hex" in
        ??????7F|00000000000000000000000001000000|0000000000000000FFFF0000??????7F) if [ "$found" != yes ]; then found=no; fi ;;
        *) found=yes ;;
      esac
    done < <(tail -n +2 "$f")
  done
  printf '%s' "$found"
}
unit_line() { grep -hE "^$1=" "$UNIT_FILE" 2>/dev/null | tr '\n' ' ' | sed 's/ $//'; }
absent() { if [ -e "$2" ] || [ -L "$2" ]; then say "    PRESENT  $1 ($2) — not from this package"; else say "    absent   $1"; fi; }
env_value() { sed -n "s|^$1=\(.*\)\$|\1|p" "$ETC/env" 2>/dev/null | tail -n 1; }

cmd_audit() {
  local uid='' port bind served remote node_ver major rest minor proxy shown pid run_node node_pkg lock
  say "open-ALERT base station — security posture"
  say "Taken $(date -u +%Y-%m-%dT%H:%M:%SZ) on $(hostname) ($(sed -n 's/^PRETTY_NAME="\(.*\)"$/\1/p' /etc/os-release 2>/dev/null), $(uname -m))"
  is_root || say "NOTE: not run as root, so the agent's settings, the firewall and the sudo rules could not be read. For all of it: sudo open-alert-base audit"
  say ""
  say "1. What is installed"
  say "    open-alert-base $(package_version)"
  say "    RPi ALERT agent $(agent_version), unchanged from the signed release $(pin AGENT_TAG)"
  say "      release tarball sha256 $(pin AGENT_SHA256)"
  say "      release key     $(pin KEY_FINGERPRINT)"
  if ( cd "$AGENT" && sha256sum --quiet -c "$SHARE/agent.sha256" >/dev/null 2>&1 ) \
     && [ "$(cd "$AGENT" && find . -type f | wc -l)" = "$(wc -l < "$SHARE/agent.sha256")" ]; then
    say "    agent files     $(wc -l < "$SHARE/agent.sha256") files, each the same as in the signed release (SHA-256 checked just now)"
  else
    say "    agent files     DIFFERENT from the signed release — see: cd $AGENT && sha256sum -c $SHARE/agent.sha256"
  fi
  # The Node.js the service runs: /usr/bin/node, unless /etc/open-alert-base/env names another.
  run_node=$NODE
  if is_root && [ -n "$(env_value OPEN_ALERT_BASE_NODE)" ]; then run_node=$(env_value OPEN_ALERT_BASE_NODE); fi
  node_ver=$("$run_node" -p 'process.versions.node' 2>/dev/null || echo unknown)
  node_pkg=$(dpkg-query -S "$(readlink -f "$run_node" 2>/dev/null || echo "$run_node")" 2>/dev/null | head -n 1 | cut -d: -f1 || true)
  if [ -n "$node_pkg" ]; then
    say "    Node.js         $node_ver ($run_node), from the operating system's package $node_pkg $(dpkg-query -W -f '${Version}' "$node_pkg" 2>/dev/null || true)"
  else
    say "    Node.js         $node_ver ($run_node) — NOT from an operating-system package: its updates are not the operating system's"
  fi
  say "    radio driver    $(rtl_line)"
  say "    No packages from npm: the agent uses none."

  say ""
  say "2. Who it runs as"
  if id "$SVC_USER" >/dev/null 2>&1; then
    uid=$(id -u "$SVC_USER")
    say "    user $SVC_USER (id $uid), groups: $(id -Gn "$SVC_USER")"
    say "    login shell $(getent passwd "$SVC_USER" | cut -d: -f7); password: $(if is_root; then case "$(passwd -S "$SVC_USER" 2>/dev/null | awk '{print $2}')" in L|LK) echo "locked (none can be typed)" ;; NP) echo "EMPTY" ;; P|PS) echo "SET" ;; *) echo "unknown" ;; esac; else echo "ask as root"; fi)"
  else
    say "    the user $SVC_USER does not exist"
  fi
  say "    root helper: none. The agent looks for one at $(unit_line Environment | tr ' ' '\n' | sed -n 's/^Environment=RPI_ALERT_PRIV=//p' | head -n 1)"
  if [ -e "$(unit_line Environment | tr ' ' '\n' | sed -n 's/^Environment=RPI_ALERT_PRIV=//p' | head -n 1)" ]; then
    say "      SOMETHING IS AT THAT PATH — it should not exist"
  else
    say "      and nothing is there, so it can ask the administrator account for nothing"
  fi
  if is_root; then
    if grep -rlE "(^|[^a-z-])$SVC_USER([^a-z-]|\$)" /etc/sudoers /etc/sudoers.d 2>/dev/null | grep -q .; then
      say "    sudo rules naming $SVC_USER: FOUND in $(grep -rlE "(^|[^a-z-])$SVC_USER([^a-z-]|\$)" /etc/sudoers /etc/sudoers.d 2>/dev/null | tr '\n' ' ')— not from this package"
    else
      say "    sudo rules naming $SVC_USER: none"
    fi
  fi

  say ""
  say "3. What it is kept from (the service's own file, $UNIT_FILE)"
  local k
  for k in NoNewPrivileges CapabilityBoundingSet AmbientCapabilities ProtectSystem ReadWritePaths StateDirectory ProtectHome PrivateTmp PrivateMounts \
           ProtectProc ProtectKernelTunables ProtectKernelModules ProtectKernelLogs ProtectControlGroups ProtectClock ProtectHostname \
           DevicePolicy DeviceAllow RestrictAddressFamilies RestrictNamespaces RestrictRealtime RestrictSUIDSGID LockPersonality \
           SystemCallArchitectures SystemCallFilter UMask; do
    say "    $(unit_line "$k" | sed "s/ $k=/, /g")"
  done
  if [ -f "$DROPIN" ]; then
    say "    Privileges: one. The dashboard's port is below 1024, so $DROPIN adds:"
    grep -hE '^(AmbientCapabilities|CapabilityBoundingSet)=' "$DROPIN" | sed 's/^/      /'
  else
    say "    Privileges: none at all (CapabilityBoundingSet and AmbientCapabilities are empty)."
  fi
  if [ -f "$LOCK_DROPIN" ]; then
    say "    Tied to the firewall lock: yes — $LOCK_DROPIN makes the service run only while $FW_UNIT does (no lock, no agent)."
  else
    say "    Tied to the firewall lock: no (this profile does not use the lock)."
  fi
  say "    Not set: MemoryDenyWriteExecute — Node.js makes machine code as it runs and needs such memory."
  pid=$(agent_pid)
  if [ -n "$pid" ] && [ -r "/proc/$pid/status" ]; then
    say "    As it runs at this moment (process $pid, read from the kernel):"
    say "      user id                 $(proc_status "$pid" Uid | awk '{print $2}') (effective), group ids $(proc_status "$pid" Groups)"
    say "      privileges in use       $(caps_in_words "$(proc_status "$pid" CapEff)")"
    say "      privileges it could get $(caps_in_words "$(proc_status "$pid" CapBnd)")"
    case "$(proc_status "$pid" NoNewPrivs)" in
      1) say "      no-new-privileges       on (sudo and set-user-id programs do nothing for it)" ;;
      *) say "      no-new-privileges       OFF" ;;
    esac
    case "$(proc_status "$pid" Seccomp)" in
      2) say "      system-call filter      on" ;;
      *) say "      system-call filter      OFF" ;;
    esac
  else
    say "    The agent is not running at this moment, so only the service's file could be read."
  fi
  if have_systemd && command -v systemd-analyze >/dev/null 2>&1; then
    say "    systemd's own score: $(systemd-analyze security --no-pager "$UNIT" 2>/dev/null | sed -n 's/^.*Overall exposure level for [^:]*: *//p' | sed 's/ *[^ -~].*$//')  (0 is the most closed, 10 the most open)"
  fi

  say ""
  say "4. What listens on the network (sockets the user $SVC_USER has open now)"
  if [ -n "$uid" ]; then listening "$uid"; fi
  say "    Nothing else in this package listens. Flood-Net never connects in: the agent calls out."

  say ""
  say "5. Profile and the settings that decide the posture"
  say "    profile in force: $(current_profile)"
  if is_root && load_summary; then
    port=$(setting web.port); bind=$(setting web.bind); remote=$(setting remote.mode); served=$(served_port "$port")
    load_profile
    if [ -n "$(setting unusable)" ]; then
      say "    FAULT — THE SETTINGS FILE CANNOT BE USED: $(setting unusable). The agent runs on its built-in settings, and what follows is those."
    elif [ -n "$(setting problems)" ]; then
      say "    SETTINGS FILE PROBLEM: $(setting problems)"
    fi
    load_held
    if profile_locks && ! is_loopback "$bind"; then
      say "    FAULT — THE SETTINGS NO LONGER MATCH THE PROFILE: \"$P_NAME\" keeps the dashboard to this computer, and the settings file"
      say "      (which the agent's own user can write) no longer asks for that: web.bind is $(if [ -n "$bind" ]; then echo "\"$bind\""; else echo "empty (every address)"; fi). The firewall lock is kept on all the same,"
      say "      and web.bind is put back to $P_BIND when the agent next starts. If nobody changed it on purpose, find out who did."
      say "      To put it back now: sudo open-alert-base sync"
    fi
    while IFS= read -r k; do
      [ -n "$k" ] || continue
      say "    FAULT — THE SETTINGS NO LONGER MATCH THE PROFILE: $k."
      say "      The settings file (which the agent's own user can write) is looser than the profile holds; it is put back when the agent next starts."
      say "      If nobody changed it on purpose, find out who did. To put it back now: sudo open-alert-base sync"
    done < <(looser_others)
    if [ -n "$P_NAME" ] && [ "$port" -lt 1024 ] 2>/dev/null && [ "${P_PORT:-0}" -ge 1024 ] 2>/dev/null; then
      say "    FAULT — THE SETTINGS NO LONGER MATCH THE PROFILE: the settings put the dashboard on port $port (below 1024); \"$P_NAME\" uses port $P_PORT,"
      say "      and gives the service no privilege for a low port. None is given."
    fi
    [ -n "$P_NAME" ] || say "    no profile is recorded, so the settings file alone decides the lock and the low-port privilege"
    if [ "$served" != "$port" ]; then
      say "    dashboard port          $served, plain HTTP, password $(setting web.password) — the settings ask for $port, which the service has no privilege for, so the agent falls back to $served"
    else
      say "    dashboard port          $port, plain HTTP, password $(setting web.password)"
    fi
    if [ -z "$bind" ]; then say "    web.bind                empty — the dashboard listens on every address of this computer"
    else say "    web.bind                $bind — the dashboard listens on $(if is_loopback "$bind"; then echo "this computer's own address only"; else echo "$bind, and on this computer's own address (127.0.0.1)"; fi)"; fi
    say "    web.behindProxy         $(setting web.behindProxy) — $(itself_words "$(setting web.behindProxy)")"
    say "    web.requireLogin        $(setting web.requireLogin) — $(login_words "$(setting web.requireLogin)")"
    say "    web.hosts               $(if [ -n "$(setting web.hosts)" ]; then echo "$(setting web.hosts) — more names the dashboard answers to"; else echo "none — the dashboard answers only to this computer's addresses, its own name and localhost"; fi)"
    if [ -n "$P_HELD" ]; then
      say "    held by the profile     $P_HELD — the settings file, which the agent's own user can write, may ask for more, never for less:"
      say "                            what it has looser is put back each time the agent starts"
    fi
    if is_loopback "$bind" || profile_locks; then
      # Said from what is so at this moment, not from what the settings ask for.
      lock=$(lock_state)
      case "$lock:$(reach_of "$uid")" in
        on:no)  say "    dashboard reach         this computer only — the firewall lock is on, and the agent itself listens on this computer's own address only" ;;
        on:yes) say "    dashboard reach         this computer only — the firewall lock is on; but the agent itself listens on every address (see 4), so the lock alone keeps other computers out" ;;
        on:*)   say "    dashboard reach         this computer only — the firewall lock is on (the agent is not running now)" ;;
        *:no)   say "    dashboard reach         this computer only — the agent listens on this computer's own address only; the firewall lock, the second guard, is $lock" ;;
        *:yes)  say "    dashboard reach         NOT KEPT TO THIS COMPUTER — it should be, but the agent listens on every address (see 4) and the firewall lock is $lock" ;;
        *)      say "    dashboard reach         meant for this computer only; the agent is not running and the firewall lock is $lock, so that cannot be confirmed now" ;;
      esac
      say "    firewall lock           $lock  (table inet $FW_TABLE; $FW_UNIT)"
      if have_systemd; then
        case "$(systemctl is-active "$FW_UNIT" 2>/dev/null || true)" in
          active) say "    the lock's keeper       running — it puts the table back at once if something clears the firewall, and the agent runs only while it does" ;;
          *)      say "    the lock's keeper       NOT RUNNING ($(systemctl is-active "$FW_UNIT" 2>/dev/null || true)) — see: systemctl status $FW_UNIT" ;;
        esac
      fi
    else
      if [ -n "$bind" ]; then say "    dashboard reach         the network, on $bind only"
      else say "    dashboard reach         the local network (every address of this computer)"; fi
      say "                            from another computer: $(login_words "$(setting web.requireLogin)")"
      say "    firewall lock           not used by this profile"
    fi
    say "    anyone logged in on this computer can read and change the agent's settings through http://127.0.0.1:$served/$(if [ "$(setting web.behindProxy)" = true ]; then echo " (asking for it by that name)"; fi)"
    case "$remote" in
      manage) say "    remote management       manage — Flood-Net's administrators may change radio settings and restart receivers; with no root helper they cannot reboot, update or touch SSH" ;;
      report) say "    remote management       report — Flood-Net is told how the base station is; whatever it asks is refused" ;;
      off)    say "    remote management       off — no check-ins at all" ;;
      *)      say "    remote management       $remote" ;;
    esac
    say "    self-recovery           $(setting recover.mode)  (off: it never reboots or restarts networking by itself; with no root helper it could not anyway)"
    say "    own Wi-Fi hotspot       $(setting hotspot.mode)"
    say "    screen kiosk            $(setting kiosk.mode)"
    say "    audio                   $(setting audio.mode)"
    say "    sends to Flood-Net      $(setting meganet.enabled) (every frame heard too: $(setting meganet.receptions)); token $(setting meganet.token)"
    say "    calls out to            $(setting hosts.readings) (readings)"
    say "                            $(setting hosts.stations) (station names, daily)"
    case " $(setting hosts.readings) $(setting hosts.stations)" in
      *" http://"*) say "    NOT ALL OVER HTTPS: an address above starts with http://" ;;
    esac
    if [ -r "$ETC/profile" ] && k=$(profile_file "$(current_profile)"); then
      k=$(as_agent "$NODE" "$LIB/settings.js" differ "$k" 2>/dev/null || true)
      if [ -n "$k" ]; then say "    CHANGED since the profile was put in force:"; printf '%s\n' "$k" | sed 's/^/      /'; else say "    every setting the profile names is still as the profile has it"; fi
    fi
  else
    say "    (the settings are readable by root only)"
  fi

  say ""
  say "6. Web proxy and certificates"
  if is_root; then
    proxy=$(env_value HTTPS_PROXY)
    if [ -n "$proxy" ]; then
      shown=$(printf '%s' "$proxy" | sed -E 's#//[^/@]*@#//(name and password)@#')
      major=${node_ver%%.*}; rest=${node_ver#*.}; minor=${rest%%.*}
      case "$major$minor" in *[!0-9]*|'') major=0; minor=0 ;; esac
      if [ "$major" -ge 24 ] || { [ "$major" -eq 22 ] && [ "$minor" -ge 21 ]; }; then
        say "    web proxy $shown — Node.js $node_ver reads the proxy settings itself"
      else
        say "    web proxy $shown — handed to Node.js $node_ver by $LIB/proxy-preload.js"
      fi
      say "    not through the proxy: $(env_value NO_PROXY)"
    else
      say "    no web proxy set ($ETC/env): the agent calls out directly, and nothing extra is loaded"
    fi
    if [ -n "$(env_value NODE_EXTRA_CA_CERTS)" ]; then say "    extra certificate authority file: $(env_value NODE_EXTRA_CA_CERTS)"; else say "    certificate authorities: the operating system's own list"; fi
  else
    say "    ($ETC/env is readable by root only)"
  fi

  say ""
  say "7. Parts of RPi ALERT's Raspberry Pi installer that this package does not install"
  absent "root helper and its sudo rule" /etc/sudoers.d/rpi-alert
  absent "the \"alert\" maintenance account's sudo rule" /etc/sudoers.d/rpi-alert-maint
  if id alert >/dev/null 2>&1; then say "    PRESENT  a user called \"alert\" exists on this computer — not from this package (to remove it: sudo userdel -r alert)"; else say "    absent   the \"alert\" maintenance account"; fi
  if id rpi-alert-kiosk >/dev/null 2>&1; then say "    PRESENT  a user called \"rpi-alert-kiosk\" exists on this computer — not from this package (to remove it: sudo userdel -r rpi-alert-kiosk)"; else say "    absent   the screen's own account"; fi
  if id -nG "$SVC_USER" 2>/dev/null | tr ' ' '\n' | grep -Eqx 'audio|video'; then
    say "    PRESENT  the agent's user is in the sound or video group ($(id -nG "$SVC_USER" | tr ' ' '\n' | grep -Ex 'audio|video' | tr '\n' ' ' | sed 's/ $//')) — not from this package (to take it out: sudo gpasswd -d $SVC_USER audio)"
  else
    say "    absent   the agent's user in the sound and video groups"
  fi
  absent "hourly SSH-key fetch" /etc/systemd/system/rpi-alert-access.timer
  absent "self-updater" /etc/systemd/system/rpi-alert-update.service
  absent "nightly update timer" /etc/systemd/system/rpi-alert-update-auto.timer
  absent "settings import from a boot partition, as root" /etc/systemd/system/rpi-alert-boot-config.service
  # RPi ALERT 0.24 reads its boot-partition settings from /etc/rpi-alert.conf on
  # a computer that has no boot partition — as root, through the import above
  # or "rpi-alert import-boot-config". Neither is here: the file does nothing.
  if [ -e /etc/rpi-alert.conf ] || [ -L /etc/rpi-alert.conf ]; then
    say "    PRESENT  /etc/rpi-alert.conf — not from this package, and not applied: nothing here reads it (\"rpi-alert import-boot-config\" is turned away). Settings: rpi-alert config set, or a profile"
  else
    say "    absent   /etc/rpi-alert.conf (RPi ALERT's settings file for a computer with no boot partition; this package would not apply it)"
  fi
  absent "screen kiosk" /etc/systemd/system/rpi-alert-kiosk.service
  absent "Bluetooth GPS service, as root" /etc/systemd/system/rpi-alert-btgps.service
  absent "cap on the whole system's log" /etc/systemd/journald.conf.d/rpi-alert.conf
  absent "SSH server settings" /etc/ssh/sshd_config.d/10-rpi-alert.conf
  say "    Accounts, SSH, operating-system updates and where the log goes are your organisation's own."
  say "    The agent logs to the system journal: journalctl -u open-alert-base"

  say ""
  say "8. What has not been tested"
  say "    This package has not been run with a real radio stick on a computer that is not a Raspberry Pi."
  say "    Its tests use stand-ins for the sticks. See /usr/share/doc/open-alert-base/README."
}

# ── selftest ─────────────────────────────────────────────────────────────────
# What of the agent's own tests is left out, and why: they test parts of RPi
# ALERT's own Raspberry Pi install that this package does not install — its
# root helper, its updater, and (by name, three tests in files that are
# otherwise run) its installer's own files in the release's os/ folder.
LEFT_OUT_FILES="priv-net.test.js update-tag.test.js"
LEFT_OUT_TESTS=(
  "settings file: a Wi-Fi network is joined on whichever Wi-Fi device the computer has"
  "install.sh sets config.json's owner and mode only through ownNoFollow, never chmod on the path"
  "settings file: one in the agent's own directory is never applied"
)
# Node.js runs only the tests whose names match this. A test also runs when
# the one around it matches; the outermost of all is called "<root>", which
# the last part keeps from matching. Node.js 18 and 20 list a test left out
# as "# SKIP test name does not match pattern"; 22 and newer leave it out of
# the count.
name_pattern() {
  local n out=''
  for n in "${LEFT_OUT_TESTS[@]}"; do out="${out:+$out|}$(printf '%s' "$n" | sed 's/[][\\.^$*+?(){}|/]/\\&/g')"; done
  printf '^(?!(%s)$)[^<]' "$out"
}
# Run test files of the agent, as the service's user when root. Output to $1.
run_tests() {
  local out=$1 pat; shift
  pat=$(name_pattern)
  if is_root; then
    ( cd "$AGENT" && runuser -u "$SVC_USER" -- env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/tmp TMPDIR=/tmp "$run_node" --test --test-reporter=tap "--test-name-pattern=$pat" "$@" ) > "$out" 2>&1
  else
    ( cd "$AGENT" && env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME="${TMPDIR:-/tmp}" TMPDIR="${TMPDIR:-/tmp}" "$run_node" --test --test-reporter=tap "--test-name-pattern=$pat" "$@" ) > "$out" 2>&1
  fi
}

cmd_selftest() {
  local log f files=() again=() rc=0 left=0 files_rc=0
  run_node="$NODE"
  if is_root && [ -n "$(env_value OPEN_ALERT_BASE_NODE)" ]; then run_node=$(env_value OPEN_ALERT_BASE_NODE); fi
  say "Self-test on $(hostname): $(sed -n 's/^PRETTY_NAME="\(.*\)"$/\1/p' /etc/os-release 2>/dev/null), $(uname -m), Node.js $("$run_node" --version)"
  say ""
  say "1. The agent's files against the signed release"
  if ( cd "$AGENT" && sha256sum --quiet -c "$SHARE/agent.sha256" ); then
    say "   $(wc -l < "$SHARE/agent.sha256") files, each the same as in the signed release $(pin AGENT_TAG)."
  else
    say "   SOME FILES DIFFER from the signed release (listed above)."; rc=1; files_rc=1
  fi
  say ""
  say "2. The agent's own tests (RPi ALERT's test suite, as shipped in the release; a few minutes)"
  # Two files are left out, and three tests by name (LEFT_OUT_FILES, LEFT_OUT_TESTS).
  for f in "$AGENT"/test/*.test.js; do
    case " $LEFT_OUT_FILES " in *" $(basename "$f") "*) left=$((left + 1)) ;; *) files+=("test/$(basename "$f")") ;; esac
  done
  command -v socat >/dev/null 2>&1 || say "   note: socat is not installed, so the two tests that need pretend serial ports are skipped (apt install socat)"
  command -v sshd >/dev/null 2>&1 || [ -x /usr/sbin/sshd ] || say "   note: no SSH server is installed, so the one test that checks a file against it is skipped"
  log=$(mktemp "${TMPDIR:-/tmp}/open-alert-base-selftest.XXXXXX")
  chmod 0644 "$log"
  run_tests "$log" "${files[@]}" || rc=1
  grep -E '^not ok ' "$log" | sed 's/^/   /' || true
  say "   $(grep -E '^# (tests|pass|fail|skipped) ' "$log" | sed 's/^# //' | tr '\n' ',' | sed 's/,$//; s/,/, /g')"
  # Only the tests named above may have been left out by name.
  local skipped_by_name n extra=''
  skipped_by_name=$(sed -n 's/^ *ok [0-9]* - \(.*\) # SKIP test name does not match pattern$/\1/p' "$log")
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    if ! printf '%s\n' "${LEFT_OUT_TESTS[@]}" | grep -qxF -- "$n"; then extra="$extra \"$n\""; fi
  done <<< "$skipped_by_name"
  if [ -n "$extra" ]; then say "   LEFT OUT THAT SHOULD NOT HAVE BEEN:$extra"; rc=1; files_rc=1; fi
  # Some of the agent's tests time one decoder against another, and can fail
  # on a computer that is busy with something else (the test files run side by
  # side). A file with a failure is run once more, by itself.
  if grep -q '^not ok ' "$log"; then
    again=()
    while IFS= read -r f; do again+=("test/$f"); done < <(sed -n "s|^ *location: '$AGENT/test/\\([A-Za-z0-9._-]*\\.test\\.js\\):[0-9:]*'\$|\\1|p" "$log" | sort -u)
    if [ ${#again[@]} -gt 0 ] && run_tests "$log.again" "${again[@]}"; then
      rc=$files_rc
      say "   FAILED IN THE FULL RUN, PASSED WHEN RUN AGAIN ALONE: ${again[*]}"
      say "   (a timing test on a busy computer; if it happens every time, this computer is too slow or too busy)"
      say "   second run's output: $log.again"
    else
      rc=1
      if [ ${#again[@]} -gt 0 ]; then say "   failed again when run alone: ${again[*]} (output: $log.again)"; fi
    fi
  fi
  say "   run as $(if is_root; then echo "the service's user ($SVC_USER)"; else id -un; fi), from ${#files[@]} test files"
  say "   left out: $left test files ($(printf '%s' "$LEFT_OUT_FILES" | sed 's/ /, /g')) and ${#LEFT_OUT_TESTS[@]} tests by name — they test RPi ALERT's root helper, its updater"
  say "   and its Raspberry Pi installer's own files, none of which is installed here"
  say "   full output: $log"
  say ""
  if [ "$rc" = 0 ]; then say "Self-test passed."; else say "Self-test FAILED."; fi
  say "These tests use stand-ins for the radio sticks: they show the software works on this computer, not that a real stick does."
  return "$rc"
}

# ── bench ────────────────────────────────────────────────────────────────────
cmd_bench() {
  local b="$LIB/bench/open-alert-bench.js"
  if [ ! -f "$b" ]; then
    say "The benchmark is not installed on this computer."
    say "It is firmware/bench/open-alert-bench.js in https://github.com/cdomotor-g/open-ALERT — one file, run with:"
    say "    node open-alert-bench.js $AGENT"
    return 1
  fi
  exec "$NODE" "$b" "$AGENT" "$@"
}

case "${1:-help}" in
  version|--version|-v) cmd_version ;;
  status) cmd_status ;;
  profile) shift; cmd_profile "$@" ;;
  sync) cmd_sync ;;
  audit) cmd_audit ;;
  selftest) cmd_selftest ;;
  bench) shift; cmd_bench "$@" ;;
  help|--help|-h) usage ;;
  *) warn "unknown command \"$1\""; usage >&2; exit 2 ;;
esac
