# open-ALERT base station: the RPi ALERT agent, unchanged from its signed
# release, run as an ordinary user that can ask the administrator account
# (root) for nothing.
#
# To change something here, do not edit this file (an update replaces it):
#   sudo systemctl edit open-alert-base      # your lines go in a file of their own
# Settings for the surroundings (a web proxy, a private certificate authority)
# are in /etc/open-alert-base/env.

[Unit]
Description=open-ALERT base station (RPi ALERT agent: ALERT and ALERT2 radio telemetry to Flood-Net)
Documentation=https://github.com/cdomotor-g/open-ALERT/tree/main/firmware
Documentation=https://github.com/cdomotor-g/RPi_ALERT/tree/main/docs
# Not network-online: a base station with no network still receives, decodes
# and keeps what it hears on disk; it sends when the network comes.
After=network.target open-alert-base-firewall.service

[Service]
Type=simple
User=rpi-alert
Group=rpi-alert
# plugdev: the RTL-SDR sticks. dialout: serial receivers (a Quansheng radio, an ERT-A2, a GPS).
SupplementaryGroups=plugdev dialout
ExecStart=/usr/lib/open-alert-base/start
WorkingDirectory=/var/lib/rpi-alert
Environment=NODE_ENV=production UV_THREADPOOL_SIZE=8
# The agent looks here for a program it may run as root through sudo. Nothing
# is there and nothing is installed there, so the agent can ask root for
# nothing: no reboot, no network changes, no updates, no SSH changes.
Environment=RPI_ALERT_PRIV=/nonexistent/open-alert-base-has-no-root-helper
EnvironmentFile=-/etc/open-alert-base/env
# Restart on any exit, quickly: receivers are opened again, the queue is on disk.
Restart=always
RestartSec=3
# The agent asks systemd to watch it and tells it "still alive" through
# systemd-notify, a program it starts itself, hence "all".
NotifyAccess=all
WatchdogSignal=SIGKILL
# The decoder wants the processor when a burst arrives.
Nice=-5

# ── The only two folders it may write ────────────────────────────────────────
# /var/lib/rpi-alert: what it has heard and not yet sent, and its own state.
StateDirectory=rpi-alert
StateDirectoryMode=0750
# /etc/rpi-alert: its settings (it holds the Flood-Net token: only this user reads it).
ReadWritePaths=/etc/rpi-alert
UMask=0077

# ── No way up ────────────────────────────────────────────────────────────────
# It can never gain a privilege it did not start with (sudo and set-user-id
# programs do nothing for it), and it starts with none at all. When the
# dashboard is on a port below 1024, "open-alert-base profile" adds the one
# privilege that allows that (see the service's .d folder under /etc/systemd/system).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes

# ── The rest of the computer is read-only or out of sight ────────────────────
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# ── Devices: USB device files (the sticks) and USB serial ports, nothing else ─
# No disks, no memory, no sound card, no screen. (A real-time clock chip can be
# read, not set: ProtectClock adds that by itself.)
DevicePolicy=closed
DeviceAllow=char-usb_device rw
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw

# ── Network: ordinary internet sockets and the computer's own local ones ────
# AF_UNIX: systemd's "still alive" socket and the system clock question.
# AF_NETLINK: reading the list of network addresses, and USB plug-in events.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# ── System calls: what an ordinary service needs, nothing for administrators ─
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# Not MemoryDenyWriteExecute: Node.js turns JavaScript into machine code as it
# runs, which needs memory that is both writable and executable.

[Install]
WantedBy=multi-user.target
