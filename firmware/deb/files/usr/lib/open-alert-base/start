#!/bin/bash
# Starts the RPi ALERT agent for open-alert-base.service.
#
# The service's own file says who it runs as and what it may touch. This does
# two things, then becomes the agent:
#
# 1. The settings the profile in force holds. The profile is root's own
#    (/etc/open-alert-base/profile names it); the settings file is the agent's
#    user's. Where the profile asks for the dashboard closed — on this computer
#    only (web.bind), a reverse proxy's callers never taken for this computer
#    itself (web.behindProxy), a login for everything (web.requireLogin) — the
#    settings file may ask for that or more, never for less: what it has looser
#    is put back as the profile has it, through the agent's own settings code,
#    and the service's log says so (settings.js hold). If that cannot be done,
#    the agent is not started.
#
# 2. How a web proxy is handed to Node.js:
#   No HTTPS_PROXY in /etc/open-alert-base/env: nothing is added at all.
#   Node.js 22.21 or newer (and 24 or newer): it reads the proxy settings
#     itself once told to (NODE_USE_ENV_PROXY=1).
#   Older Node.js (Debian 13's 20, Ubuntu 24.04's 18): a small file is loaded
#     first that points Node's fetch() at the proxy (proxy-preload.js).
#
# A proxy that is set is never gone around. An address without "http://" in
# front is taken as http://, as curl takes it. An address that cannot be used
# at all (socks5://…, a slip of the keyboard) does not stop the agent and does
# not let it call out directly: proxy-preload.js is loaded, on any Node.js,
# and refuses every call that should have gone through the proxy. The agent
# receives, keeps what it hears on disk, and the log says why nothing is sent.
set -euo pipefail

LIB=/usr/lib/open-alert-base
NODE="${OPEN_ALERT_BASE_NODE:-/usr/bin/node}"

if [ ! -x "$NODE" ]; then
  echo "open-alert-base: Node.js was not found at $NODE (see OPEN_ALERT_BASE_NODE in /etc/open-alert-base/env)" >&2
  exit 78
fi

# 1. The settings the profile in force holds.
profile=''
if [ -r /etc/open-alert-base/profile ]; then profile=$(head -n 1 /etc/open-alert-base/profile); fi
case "$profile" in
  ''|*[!a-z0-9-]*) ;;
  *)
    if [ -f "/usr/share/open-alert-base/profiles/$profile.json" ]; then
      rc=0
      "$NODE" "$LIB/settings.js" hold "/usr/share/open-alert-base/profiles/$profile.json" || rc=$?
      if [ "$rc" != 0 ]; then
        echo "open-alert-base: THE AGENT IS NOT STARTED: the settings the profile \"$profile\" holds could not be made to hold (see above). Put it right, then: sudo systemctl restart open-alert-base" >&2
        exit 1
      fi
    fi ;;
esac

# 2. The web proxy.

proxy="${HTTPS_PROXY:-${https_proxy:-}}"
if [ -n "$proxy" ]; then
  case "$proxy" in *://*) ;; *) proxy="http://$proxy" ;; esac
  # Both spellings, so that Node.js and curl (the agent's "is the internet there?" check) agree.
  export HTTPS_PROXY="$proxy" https_proxy="$proxy"
  exempt="${NO_PROXY:-${no_proxy:-}}"
  if [ -n "$exempt" ]; then export NO_PROXY="$exempt" no_proxy="$exempt"; fi
  version=$("$NODE" -p 'process.versions.node')
  major=${version%%.*}; rest=${version#*.}; minor=${rest%%.*}
  # A user name and password in the proxy's address stay out of the log.
  shown=$(printf '%s' "$proxy" | sed -E 's#//[^/@]*@#//(name and password)@#')
  usable=1
  case "$proxy" in http://?*|https://?*) ;; *) usable=0 ;; esac
  own=0
  if [ "$major" -ge 24 ] || { [ "$major" -eq 22 ] && [ "$minor" -ge 21 ]; }; then
    own=1
    # A Node.js that reads the proxy settings itself stops dead on an address it cannot read.
    if [ "$usable" = 1 ] && ! "$NODE" -e 'new URL(process.argv[1])' "$proxy" >/dev/null 2>&1; then usable=0; fi
  fi
  if [ "$usable" = 1 ] && [ "$own" = 1 ]; then
    export NODE_USE_ENV_PROXY=1
    echo "open-alert-base: sending through the web proxy $shown (Node.js $version reads the proxy settings itself)" >&2
  elif [ "$usable" = 1 ]; then
    export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--require=$LIB/proxy-preload.js"
    echo "open-alert-base: sending through the web proxy $shown (Node.js $version: proxy-preload.js loaded first)" >&2
  else
    export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--require=$LIB/proxy-preload.js"
    echo "open-alert-base: the web proxy's address in HTTPS_PROXY ($shown) cannot be used: nothing is sent, and nothing goes out directly, until it is put right in /etc/open-alert-base/env (proxy-preload.js loaded first, to see to that)" >&2
  fi
fi

exec "$NODE" "$LIB/agent/bin/rpi-alert" daemon
