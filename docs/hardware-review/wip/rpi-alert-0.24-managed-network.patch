+// ── the settings file where there is no boot partition (0.24) ────────────────
+
+function importer(conf, mode) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'rpa-etc-'));
+  const etc = path.join(dir, 'etc'), bootDir = path.join(dir, 'boot');
+  fs.mkdirSync(etc); fs.mkdirSync(bootDir);
+  const file = path.join(etc, 'rpi-alert.conf');
+  if (conf != null) { fs.writeFileSync(file, conf, { mode: mode || 0o600 }); fs.chmodSync(file, mode || 0o600); }
+  const env = Object.assign({}, process.env, { RPI_ALERT_CONFIG: path.join(etc, 'config.json'), RPI_ALERT_ETC_CONF: file, RPI_ALERT_BOOT_DIRS: bootDir, RPI_ALERT_DATA: path.join(dir, 'data') });
+  const run = () => require('node:child_process').spawnSync(process.execPath, [path.join(__dirname, '..', 'bin', 'rpi-alert'), 'import-boot-config'], { env, encoding: 'utf8' });
+  const settings = () => JSON.parse(fs.readFileSync(path.join(etc, 'config.json'), 'utf8'));
+  return { dir, etc, bootDir, file, run, settings };
+}
+
+test('settings file: /etc/rpi-alert/rpi-alert.conf is applied where no boot partition holds one', () => {
+  const i = importer('name = Council depot\nweb_bind = 127.0.0.1\nweb_require_login = all\nhotspot = off\nself_recovery = off\nremote_management = report\nweb_password = hunter2hunter2\n');
+  const r = i.run();
+  assert.equal(r.status, 0, r.stderr);
+  assert.match(r.stdout, /applying .*etc\/rpi-alert\.conf/);
+  const c = i.settings();
+  assert.deepEqual([c.name, c.web.bind, c.web.requireLogin, c.hotspot.mode, c.recover.mode, c.remote.mode], ['Council depot', '127.0.0.1', 'all', 'off', 'off', 'report']);
+  // As on a card: applied once, the secrets blanked, what happened beside it.
+  assert.equal(fs.existsSync(i.file), false);
+  const applied = fs.readFileSync(i.file + '.applied', 'utf8');
+  assert.match(applied, /^# Applied /);
+  assert.match(applied, /web_password = \(applied — removed from the card\)/);
+  assert.ok(!applied.includes('hunter2'));
+  assert.equal(fs.statSync(i.file + '.applied').mode & 0o777, 0o600);
+  assert.match(fs.readFileSync(path.join(i.etc, 'rpi-alert-boot.log'), 'utf8'), /settings changed: .*web\.bind/);
+  // Nothing there: nothing happens, and it says where it looked.
+  const again = i.run();
+  assert.equal(again.status, 0);
+  assert.match(again.stdout, /no rpi-alert\.conf on the boot partition or at .*rpi-alert\.conf — nothing to apply/);
+  // A second file adds to the log rather than replacing it.
+  fs.writeFileSync(i.file, 'name = Council depot 2\n', { mode: 0o600 });
+  assert.equal(i.run().status, 0);
+  assert.equal(fs.readFileSync(path.join(i.etc, 'rpi-alert-boot.log'), 'utf8').match(/applying/g).length, 2);
+});
+
+test('settings file: a boot partition\'s file comes first, and is applied as it always was', () => {
+  const i = importer('name = From etc\n');
+  fs.writeFileSync(path.join(i.bootDir, 'rpi-alert.conf'), 'name = From the card\r\n');
+  assert.equal(i.run().status, 0);
+  assert.equal(i.settings().name, 'From the card');
+  assert.ok(fs.existsSync(path.join(i.bootDir, 'rpi-alert.conf.applied')) && fs.existsSync(path.join(i.bootDir, 'rpi-alert-boot.log')));
+  assert.ok(fs.existsSync(i.file), 'the other waits for a boot with no card file');
+  assert.equal(i.run().status, 0);
+  assert.equal(i.settings().name, 'From etc');
+});
+
+test('settings file: in the agent\'s own directory only root\'s own file is applied — never a link, another\'s file, or one others may write', () => {
+  // The directory is the agent's, and this file can give the alert account a key: so the agent must not be able to write one.
+  const secret = path.join(tmp(), 'shadow'); fs.writeFileSync(secret, 'ssh_key = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPlanted attacker\n');
+  const refused = (i, why) => {
+    const r = i.run();
+    assert.equal(r.status, 0, r.stderr);
+    assert.match(r.stdout, why);
+    assert.match(r.stdout, /is applied only when it is root's own/);
+    assert.equal(fs.existsSync(path.join(i.etc, 'config.json')), false, 'nothing was applied');
+    assert.equal(fs.existsSync(i.file + '.applied'), false);
+    assert.ok(fs.lstatSync(i.file), 'and it is left where it was, to be looked at');
+  };
+  const link = importer(null);
+  fs.symlinkSync(secret, link.file);
+  refused(link, /is a link — not read/);
+  const hard = importer(null);
+  fs.linkSync(secret, hard.file);
+  refused(hard, /more than one name/);
+  refused(importer('name = Open to all\n', 0o666), /can be written by others — not read/);
+  refused(importer('name = Open to a group\n', 0o660), /can be written by others/);
+  assert.equal(fs.readFileSync(secret, 'utf8').includes('Planted'), true);
+  // The same check, by itself.
+  const mine = importer('name = Mine\n');
+  assert.equal(readNoFollow(mine.file, 1024, { rootsOwn: true }), 'name = Mine\n');
+  if (typeof process.getuid === 'function' && process.getuid() === 0) {
+    // As root (as at boot): a file the agent's user wrote is not root's word.
+    const theirs = importer('alert_password = let-me-in-please\n');
+    fs.chownSync(theirs.file, 65534, 65534);
+    refused(theirs, /is not root's file — not read/);
+    // And the applied copy of root's own file goes to the directory's owner, so it cannot be put back as root's.
+    const kept = importer('name = Kept\n');
+    fs.chownSync(kept.etc, 65534, 65534);
+    assert.equal(kept.run().status, 0);
+    assert.equal(fs.statSync(kept.file + '.applied').uid, 65534);
+    fs.renameSync(kept.file + '.applied', kept.file);
+    assert.match(kept.run().stdout, /is not root's file — not read/, 'put back under the settings file\'s name, it is not applied again');
+  }
+});
