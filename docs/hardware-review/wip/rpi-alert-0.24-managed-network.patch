+  try {
+    const visitor = await from('203.0.113.7');
+    const own = await stream(s.port).ready; open.push(own);
+    assert.deepEqual([visitor.status, own.status], [200, 200]);
+    s.web.broadcast('log', { msg: 'for those let in' }, true);
