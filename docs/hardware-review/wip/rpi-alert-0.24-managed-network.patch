+    const headers = Object.assign({ Host: '127.0.0.1:' + port }, o.headers || {});
+    let body = null;
+    if (o.body !== undefined) { body = JSON.stringify(o.body); headers['Content-Type'] = 'application/json'; headers['Content-Length'] = Buffer.byteLength(body); }
