diff --git a/.github/workflows/firmware.yml b/.github/workflows/firmware.yml
new file mode 100644
index 0000000..4eea7e9
--- /dev/null
+++ b/.github/workflows/firmware.yml
@@ -0,0 +1,571 @@
+name: firmware
+
+# Builds and checks everything under firmware/ — the native package, the
+# container and the disk images — on GitHub's own computers, for ordinary
+# 64-bit PCs (x86-64) and for 64-bit ARM. Nothing here uses a real radio
+# stick: see "What has been tested, and where" in firmware/README.md.
+#
+# It runs when a push changes something under firmware/ (or this file), and
+# when a person starts it by hand (Actions → firmware → Run workflow). Nothing
+# else starts it.
+#
+# Started by hand WITH a release tag, and only then, it also publishes: the
+# container to ghcr.io/<owner>/open-alert-base, and a GitHub release under that
+# tag with the package, the disk images, their checksums, a bill of materials
+# for each, and GitHub's signed record of where each file was built
+# ("build provenance"). It publishes only what passed its checks in the same
+# run.
+#
+# The only actions used are GitHub's own (actions/…): checkout, the two that
+# keep and fetch a job's files, and the one that writes build provenance.
+# Each is pinned to one exact commit; its version is in the comment beside
+# it. To move one, look the new commit up
+# (git ls-remote https://github.com/actions/NAME refs/tags/vX.Y.Z) and change
+# both. Signing in to the container registry is one line of "docker login",
+# not an action.
+#
+# This file has not yet run on GitHub: its first push is its first run. See
+# "How it is built and checked automatically" in firmware/README.md.
+
+on:
+  push:
+    # Branches are named so that a tag being made does not start a run.
+    branches: ['**']
+    paths:
+      - 'firmware/**'
+      - '.github/workflows/firmware.yml'
+  workflow_dispatch:
+    inputs:
+      release_tag:
+        description: 'Publish a release under this tag (for example firmware-0.23.1-oa1). Leave empty to build and check only.'
+        required: false
+        default: ''
+        type: string
+      prerelease:
+        description: 'Mark the release "pre-release". Leave on until an image has started on a real computer and heard a real stick.'
+        required: false
+        default: true
+        type: boolean
+
+# No job may do anything it does not ask for by name.
+permissions: {}
+
+# A newer push stops an older run of the same branch. A release run is never
+# stopped half-way by a push: it has a group of its own.
+concurrency:
+  group: firmware-${{ github.ref }}-${{ inputs.release_tag || 'check' }}
+  cancel-in-progress: ${{ github.event_name == 'push' }}
+
+env:
+  RELEASE_TAG: ${{ inputs.release_tag }}
+
+jobs:
+  # ── (a) the scripts ────────────────────────────────────────────────────────
+  scripts:
+    name: Scripts (shellcheck)
+    runs-on: ubuntu-24.04
+    timeout-minutes: 10
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - name: Every shell script under firmware/ passes shellcheck
+        run: |
+          set -euo pipefail
+          command -v shellcheck >/dev/null || { sudo apt-get update -qq; sudo apt-get install -y --no-install-recommends shellcheck; }
+          files=()
+          while IFS= read -r f; do
+            if head -n 1 "$f" | grep -Eq '^#!.*[/ ](ba)?sh( |$)'; then files+=("$f"); fi
+          done < <(git ls-files firmware)
+          echo "shellcheck $(shellcheck --version | awk '/^version:/ {print $2}') on ${#files[@]} scripts:"
+          printf '  %s\n' "${files[@]}"
+          LC_ALL=C.UTF-8 shellcheck -x "${files[@]}"
+      - name: The release tag, if one was given, is a plain name
+        if: ${{ inputs.release_tag != '' }}
+        run: |
+          set -euo pipefail
+          printf '%s' "$RELEASE_TAG" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]{0,80}$' \
+            || { echo "::error::The release tag may hold letters, digits, dots, dashes and underscores only (no \"+\": the same name is given to the container, and a container's tag may not hold one). Got: $RELEASE_TAG"; exit 1; }
+
+  # ── (b) the native package ─────────────────────────────────────────────────
+  package:
+    name: Package (${{ matrix.arch }})
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - { arch: amd64, runner: ubuntu-24.04 }
+          - { arch: arm64, runner: ubuntu-24.04-arm }
+    runs-on: ${{ matrix.runner }}
+    timeout-minutes: 75
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - name: Tools
+        run: |
+          sudo apt-get update -qq
+          sudo apt-get install -y --no-install-recommends shellcheck lintian openssl
+      # The two files are handed to each script by option. They are not put in
+      # the variables the scripts read by themselves (OA_AGENT_TARBALL,
+      # OA_AGENT_SIG): test/deb.sh checks what the release check does when it
+      # is given a tarball without a signature, and such a variable would hand
+      # it one behind its back.
+      - name: The pinned RPi ALERT release, downloaded once and checked (hash and signature)
+        run: |
+          set -euo pipefail
+          firmware/lib/fetch-agent.sh --verify-only --download-dir "$RUNNER_TEMP/release"
+          tarball=$(find "$RUNNER_TEMP/release" -name '*-src.tar.gz' | head -n 1)
+          echo "PINNED_TARBALL=$tarball" >> "$GITHUB_ENV"
+          echo "PINNED_SIG=$tarball.sig" >> "$GITHUB_ENV"
+      - name: Build the package
+        run: firmware/deb/build-deb.sh --tarball "$PINNED_TARBALL" --sig "$PINNED_SIG" --lintian
+      - name: Check it (firmware/test/deb.sh — Debian 13, Ubuntu 24.04, Debian 12; about 20 minutes)
+        run: |
+          set -euo pipefail
+          deb=$(find dist -maxdepth 1 -name 'open-alert-base_*_all.deb' | head -n 1)
+          rc=0
+          firmware/test/deb.sh --deb "$deb" --tarball "$PINNED_TARBALL" --sig "$PINNED_SIG" 2>&1 | tee "$RUNNER_TEMP/deb-test.txt" || rc=$?
+          {
+            echo "### Package checks on ${{ matrix.arch }}"
+            echo '```'
+            grep -E '^[0-9]+ passed, |^FAIL  |^skip  ' "$RUNNER_TEMP/deb-test.txt" || true
+            echo '```'
+          } >> "$GITHUB_STEP_SUMMARY"
+          exit "$rc"
+      - name: Keep the package
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: package-${{ matrix.arch }}
+          path: dist/open-alert-base_*_all.deb
+          if-no-files-found: error
+          retention-days: 14
+      - name: Keep the logs
+        if: ${{ always() }}
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: logs-package-${{ matrix.arch }}
+          path: dist/test-logs/
+          if-no-files-found: ignore
+          retention-days: 14
+
+  # The package holds no compiled code: built on a PC and on an ARM computer
+  # it must be the same file, byte for byte.
+  package-same:
+    name: Package is the same file from both kinds of computer
+    needs: package
+    runs-on: ubuntu-24.04
+    timeout-minutes: 5
+    permissions: {}
+    steps:
+      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          pattern: package-*
+          path: packages
+      - run: |
+          set -euo pipefail
+          sha256sum packages/package-amd64/*.deb packages/package-arm64/*.deb
+          cmp packages/package-amd64/*.deb packages/package-arm64/*.deb
+
+  # ── (c) the container ──────────────────────────────────────────────────────
+  container:
+    name: Container (${{ matrix.arch }})
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - { arch: amd64, runner: ubuntu-24.04 }
+          - { arch: arm64, runner: ubuntu-24.04-arm }
+    runs-on: ${{ matrix.runner }}
+    timeout-minutes: 60
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - name: Tools
+        run: |
+          sudo apt-get update -qq
+          sudo apt-get install -y --no-install-recommends shellcheck openssl socat
+          # The check script itself is helped by Node.js on this computer;
+          # GitHub's computers have one, and this is for the day one does not.
+          command -v node >/dev/null || sudo apt-get install -y --no-install-recommends nodejs
+      - name: The pinned RPi ALERT release, downloaded once and checked (hash and signature)
+        run: |
+          set -euo pipefail
+          firmware/lib/fetch-agent.sh --verify-only --download-dir "$RUNNER_TEMP/release"
+          tarball=$(find "$RUNNER_TEMP/release" -name '*-src.tar.gz' | head -n 1)
+          echo "PINNED_TARBALL=$tarball" >> "$GITHUB_ENV"
+          echo "PINNED_SIG=$tarball.sig" >> "$GITHUB_ENV"
+      - name: Build and check the container (firmware/test/container.sh)
+        run: |
+          set -euo pipefail
+          rc=0
+          firmware/test/container.sh --tarball "$PINNED_TARBALL" --sig "$PINNED_SIG" 2>&1 | tee "$RUNNER_TEMP/container-test.txt" || rc=$?
+          {
+            echo "### Container checks on ${{ matrix.arch }}"
+            echo '```'
+            grep -E '^[0-9]+ passed, |^FAIL  |^skip  ' "$RUNNER_TEMP/container-test.txt" || true
+            echo '```'
+          } >> "$GITHUB_STEP_SUMMARY"
+          exit "$rc"
+      - name: Keep the logs
+        if: ${{ always() }}
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: logs-container-${{ matrix.arch }}
+          path: dist/test-logs/
+          if-no-files-found: ignore
+          retention-days: 14
+
+  # ── (d) the disk images ────────────────────────────────────────────────────
+  image-amd64:
+    name: Disk image for PCs (amd64) — build, then start it with Secure Boot on
+    runs-on: ubuntu-24.04
+    timeout-minutes: 90
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - name: Tools (Debian's installer-into-a-folder, disk tools, QEMU and its UEFI firmware)
+        run: |
+          sudo apt-get update -qq
+          sudo apt-get install -y --no-install-recommends mmdebstrap debian-archive-keyring fdisk dosfstools mtools \
+            e2fsprogs xz-utils jq openssl socat sbsigntool qemu-system-x86 ovmf
+      - name: Let this job use the processor's own virtualisation (KVM), where GitHub's computer has it
+        run: |
+          if [ -e /dev/kvm ]; then
+            echo 'KERNEL=="kvm", GROUP="kvm", MODE="0666", OPTIONS+="static_node=kvm"' | sudo tee /etc/udev/rules.d/99-kvm4all.rules
+            sudo udevadm control --reload-rules
+            sudo udevadm trigger --name-match=kvm
+          else
+            echo "No /dev/kvm here: the start test will emulate the processor, slowly."
+          fi
+      - name: The pinned RPi ALERT release, downloaded once and checked (hash and signature)
+        run: |
+          set -euo pipefail
+          firmware/lib/fetch-agent.sh --verify-only --download-dir "$RUNNER_TEMP/release"
+          tarball=$(find "$RUNNER_TEMP/release" -name '*-src.tar.gz' | head -n 1)
+          echo "PINNED_TARBALL=$tarball" >> "$GITHUB_ENV"
+          echo "PINNED_SIG=$tarball.sig" >> "$GITHUB_ENV"
+      - name: Build the image (firmware/image/build-image.sh)
+        run: |
+          set -euo pipefail
+          sudo firmware/image/build-image.sh --arch amd64 --tarball "$PINNED_TARBALL" --sig "$PINNED_SIG"
+          sudo chown -R "$(id -u):$(id -g)" dist
+      - name: Start it and check it (firmware/test/image.sh)
+        run: |
+          set -euo pipefail
+          rc=0
+          firmware/test/image.sh --arch amd64 2>&1 | tee "$RUNNER_TEMP/image-test.txt" || rc=$?
+          {
+            echo "### Disk image for PCs: start test"
+            echo '```'
+            grep -E '^[0-9]+ passed, |^FAIL  |^skip  |EXPOSURE SCORE|a login prompt on the serial console' "$RUNNER_TEMP/image-test.txt" || true
+            echo '```'
+          } >> "$GITHUB_STEP_SUMMARY"
+          exit "$rc"
+      - name: Keep the image, its checksum and its lists of contents
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: image-amd64
+          path: |
+            dist/open-alert-base-*-amd64-uefi.img.xz
+            dist/open-alert-base-*-amd64-uefi.img.xz.sha256
+            dist/open-alert-base-*-amd64-uefi.packages.tsv
+            dist/open-alert-base-*-amd64-uefi.spdx.json
+          if-no-files-found: error
+          compression-level: 0
+          retention-days: 14
+      - name: Keep the logs
+        if: ${{ always() }}
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: logs-image-amd64
+          path: dist/test-logs/
+          if-no-files-found: ignore
+          retention-days: 14
+
+  # The ARM image is built on an ARM computer (the build does not cross over).
+  # Its start test has never been run by anybody: the first runs of this job
+  # are its first runs. So a failed start test does not fail the whole run —
+  # but an ARM image whose start test did not pass is not published.
+  image-arm64:
+    name: Disk image for 64-bit ARM (arm64) — build, then try to start it
+    runs-on: ubuntu-24.04-arm
+    timeout-minutes: 120
+    permissions:
+      contents: read
+    outputs:
+      started: ${{ steps.start.outcome }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - name: Tools
+        run: |
+          sudo apt-get update -qq
+          sudo apt-get install -y --no-install-recommends mmdebstrap debian-archive-keyring fdisk dosfstools mtools \
+            e2fsprogs xz-utils jq openssl socat sbsigntool qemu-system-arm qemu-efi-aarch64
+      - name: The pinned RPi ALERT release, downloaded once and checked (hash and signature)
+        run: |
+          set -euo pipefail
+          firmware/lib/fetch-agent.sh --verify-only --download-dir "$RUNNER_TEMP/release"
+          tarball=$(find "$RUNNER_TEMP/release" -name '*-src.tar.gz' | head -n 1)
+          echo "PINNED_TARBALL=$tarball" >> "$GITHUB_ENV"
+          echo "PINNED_SIG=$tarball.sig" >> "$GITHUB_ENV"
+      - name: Build the image (firmware/image/build-image.sh)
+        run: |
+          set -euo pipefail
+          sudo firmware/image/build-image.sh --arch arm64 --tarball "$PINNED_TARBALL" --sig "$PINNED_SIG"
+          sudo chown -R "$(id -u):$(id -g)" dist
+      - name: Try to start it (firmware/test/image.sh; QEMU emulating an ARM computer)
+        id: start
+        continue-on-error: true
+        run: |
+          set -euo pipefail
+          rc=0
+          firmware/test/image.sh --arch arm64 2>&1 | tee "$RUNNER_TEMP/image-test.txt" || rc=$?
+          {
+            echo "### Disk image for ARM: start test"
+            echo '```'
+            grep -E '^[0-9]+ passed, |^FAIL  |^skip  |EXPOSURE SCORE|a login prompt on the serial console' "$RUNNER_TEMP/image-test.txt" || true
+            echo '```'
+          } >> "$GITHUB_STEP_SUMMARY"
+          exit "$rc"
+      - name: Say so plainly if it did not start
+        if: ${{ steps.start.outcome != 'success' }}
+        run: echo "::warning::The ARM disk image was built but did NOT pass its start test. It will not be published. See the logs of this job."
+      - name: Keep the image, its checksum and its lists of contents
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: image-arm64
+          path: |
+            dist/open-alert-base-*-arm64-uefi.img.xz
+            dist/open-alert-base-*-arm64-uefi.img.xz.sha256
+            dist/open-alert-base-*-arm64-uefi.packages.tsv
+            dist/open-alert-base-*-arm64-uefi.spdx.json
+          if-no-files-found: error
+          compression-level: 0
+          retention-days: 14
+      - name: Keep the logs
+        if: ${{ always() }}
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: logs-image-arm64
+          path: dist/test-logs/
+          if-no-files-found: ignore
+          retention-days: 14
+
+  # ── (e) the benchmark's quick test ─────────────────────────────────────────
+  bench:
+    name: Benchmark, quick test (${{ matrix.arch }})
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - { arch: amd64, runner: ubuntu-24.04 }
+          - { arch: arm64, runner: ubuntu-24.04-arm }
+    runs-on: ${{ matrix.runner }}
+    timeout-minutes: 20
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - name: Node.js, if this computer has none
+        run: command -v node >/dev/null || { sudo apt-get update -qq; sudo apt-get install -y --no-install-recommends nodejs; }
+      - name: The pinned RPi ALERT release, checked and unpacked
+        run: firmware/lib/fetch-agent.sh --out "$RUNNER_TEMP/release"
+      - name: firmware/bench/test.sh
+        run: |
+          node --version
+          firmware/bench/test.sh "$RUNNER_TEMP/release/agent"
+
+  # ── (c, continued) publish the container — only with a release tag ─────────
+  # Each kind of computer builds its own image, checks that very image, and
+  # only then pushes it. A last job joins the two under one name.
+  container-publish:
+    name: Publish the container (${{ matrix.arch }})
+    if: ${{ inputs.release_tag != '' }}
+    needs: [scripts, package, package-same, container, image-amd64, bench]
+    strategy:
+      matrix:
+        include:
+          - { arch: amd64, runner: ubuntu-24.04 }
+          - { arch: arm64, runner: ubuntu-24.04-arm }
+    runs-on: ${{ matrix.runner }}
+    timeout-minutes: 60
+    permissions:
+      contents: read
+      packages: write
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - name: Tools
+        run: |
+          sudo apt-get update -qq
+          sudo apt-get install -y --no-install-recommends shellcheck openssl socat
+          # The check script itself is helped by Node.js on this computer;
+          # GitHub's computers have one, and this is for the day one does not.
+          command -v node >/dev/null || sudo apt-get install -y --no-install-recommends nodejs
+      - name: The pinned RPi ALERT release, downloaded once and checked (hash and signature)
+        run: |
+          set -euo pipefail
+          firmware/lib/fetch-agent.sh --verify-only --download-dir "$RUNNER_TEMP/release"
+          tarball=$(find "$RUNNER_TEMP/release" -name '*-src.tar.gz' | head -n 1)
+          echo "PINNED_TARBALL=$tarball" >> "$GITHUB_ENV"
+          echo "PINNED_SIG=$tarball.sig" >> "$GITHUB_ENV"
+      - name: Build the image that will be published (firmware/container/build.sh)
+        run: |
+          set -euo pipefail
+          image="ghcr.io/${GITHUB_REPOSITORY_OWNER,,}/open-alert-base:${RELEASE_TAG}-${{ matrix.arch }}"
+          echo "IMAGE=$image" >> "$GITHUB_ENV"
+          firmware/container/build.sh --tag "$image" --release-dir "$RUNNER_TEMP/release"
+      - name: Check that very image (firmware/test/container.sh --image)
+        run: firmware/test/container.sh --image "$IMAGE" --tarball "$PINNED_TARBALL" --sig "$PINNED_SIG"
+      - name: Sign in to GitHub's container registry (ghcr.io) with this run's own token
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: printf '%s' "$GH_TOKEN" | docker login ghcr.io --username "$GITHUB_ACTOR" --password-stdin
+      - name: Push it
+        run: docker push "$IMAGE"
+
+  container-manifest:
+    name: Publish the container under one name for both kinds of computer
+    if: ${{ inputs.release_tag != '' }}
+    needs: container-publish
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+    permissions:
+      packages: write        # push the joined image and its provenance to ghcr.io
+      id-token: write        # sign the provenance as this run
+      attestations: write    # record it with GitHub
+    steps:
+      - name: Sign in to GitHub's container registry (ghcr.io) with this run's own token
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: printf '%s' "$GH_TOKEN" | docker login ghcr.io --username "$GITHUB_ACTOR" --password-stdin
+      - name: Join the two images into one two-architecture image
+        id: join
+        run: |
+          set -euo pipefail
+          name="ghcr.io/${GITHUB_REPOSITORY_OWNER,,}/open-alert-base"
+          docker buildx imagetools create --tag "$name:$RELEASE_TAG" "$name:$RELEASE_TAG-amd64" "$name:$RELEASE_TAG-arm64"
+          digest=$(docker buildx imagetools inspect "$name:$RELEASE_TAG" --format '{{json .Manifest}}' | jq -r .digest)
+          printf '%s' "$digest" | grep -Eq '^sha256:[0-9a-f]{64}$' || { echo "::error::could not read the joined image's digest"; exit 1; }
+          echo "name=$name" >> "$GITHUB_OUTPUT"
+          echo "digest=$digest" >> "$GITHUB_OUTPUT"
+          echo "Published: \`$name:$RELEASE_TAG\` (\`$digest\`), for linux/amd64 and linux/arm64" >> "$GITHUB_STEP_SUMMARY"
+      - name: GitHub's signed record of where the image was built (build provenance)
+        uses: actions/attest-build-provenance@4d101475d8b20a2381f78447822ac1eab6504dd8 # v4.2.2
+        with:
+          subject-name: ${{ steps.join.outputs.name }}
+          subject-digest: ${{ steps.join.outputs.digest }}
+          push-to-registry: true
+
+  # ── (f) the release — only with a release tag ──────────────────────────────
+  release:
+    name: Release
+    if: ${{ inputs.release_tag != '' }}
+    needs: [scripts, package, package-same, container, image-amd64, image-arm64, bench, container-manifest]
+    runs-on: ubuntu-24.04
+    timeout-minutes: 30
+    permissions:
+      contents: write        # make the tag and the release
+      id-token: write        # sign the provenance as this run
+      attestations: write    # record it with GitHub
+    env:
+      ARM_IMAGE_STARTED: ${{ needs.image-arm64.outputs.started }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
